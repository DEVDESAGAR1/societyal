# Environment Configuration Example for SocietyFix AI
# Copy to .env for local development. Never commit real credentials or secrets.

# Node Environment: 'development', 'staging', or 'production'
NODE_ENV="development"

# Server Port (Cloud Run injects PORT; default is 3000 in dev)
PORT="3000"

# Application URL
APP_URL="http://localhost:3000"

# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT="societyfix-dev"
GOOGLE_CLOUD_REGION="asia-south1"

# Database Configuration (Cloud SQL for PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# For Cloud SQL Unix socket: postgresql://societyfix_app:password@/societyfix_dev?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL="postgresql://societyfix_user:localpassword@localhost:5432/societyfix_dev"
DATABASE_SSL="false"
DATABASE_MAX_CONNECTIONS="20"

# Platform Super Admin Provisioning (M2)
# Comma-separated list of verified emails automatically recognized as Platform Super Admins
SUPER_ADMIN_EMAILS="devdesagar@gmail.com,admin@societyfix.ai"
# Secret for one-time manual bootstrap elevation via POST /api/auth/bootstrap
SUPER_ADMIN_BOOTSTRAP_SECRET="CHANGE_THIS_TO_STRONG_RANDOM_SECRET_MIN_32_CHARS"

# Firebase Server Configuration (Firebase Admin SDK)
FIREBASE_PROJECT_ID="societyfix-dev"
# Optional: Path or inline JSON for service account credentials if not using Application Default Credentials (ADC)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Firebase Client Configuration (Public Web SDK)
VITE_FIREBASE_API_KEY="AIzaSy_FIREBASE_PUBLIC_KEY"
VITE_FIREBASE_AUTH_DOMAIN="societyfix-dev.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="societyfix-dev"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# Google Cloud Storage (Private Document Bucket)
GCS_DOCUMENTS_BUCKET="societyfix-dev-documents"

# Google Cloud Tasks (Asynchronous Queue)
CLOUD_TASKS_QUEUE_NAME="societyfix-dev-tasks"
CLOUD_TASKS_LOCATION="asia-south1"

# Google AI Studio / Gemini API Key
GEMINI_API_KEY="AIzaSy_EXAMPLE_KEY_NOT_REAL"
